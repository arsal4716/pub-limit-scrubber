# Server - serves both the API and the built React app (client/dist) on this
# single port. Run `npm run build` (from client/ or via the root script)
# before starting in production so client/dist exists.
PORT=6003
NODE_ENV=development

# MongoDB - leave empty in development to auto-start an in-memory MongoDB instance
MONGO_URI=

# Admin login (single admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_JWT_SECRET=change-this-to-a-long-random-string
ADMIN_JWT_EXPIRES_IN=12h

# Buyer LM (ACA) - callgrid. Blocked when the response code is 4007 or 4005.
LM_BUYER_API_URL=https://bid.callgrid.com/api/bid/cmn6507vj00vz06juii3memo2
LM_BUYER_API_TIMEOUT_MS=10000
# LM's own daily API-call cap (applied on first boot only, editable in admin after)
LM_DAILY_LIMIT=100000

# Buyer IC (ACA) - salesradix. "Available" = allowed, anything else = blocked/duplicate.
IC_BUYER_API_URL=https://api.salesradix.com/agentavailability
IC_BUYER_API_TIMEOUT_MS=5000
IC_VERTICAL=Health
IC_SUBSOURCE_ID=3898
# IC's own daily API-call cap (applied on first boot only, editable in admin after)
IC_DAILY_LIMIT=100000

# Rate limiting: CONCURRENCY phones every BATCH_DELAY_MS, each phone pinging
# both buyer APIs at the same time. Default 20/1200ms sustains ~1000
# requests/min against each buyer independently.
BUYER_API_CONCURRENCY=20
BUYER_API_BATCH_DELAY_MS=1200

# Default global daily lead limit (applied on first boot only)
DEFAULT_TOTAL_DAILY_LIMIT=100000

# Quota resets at midnight in this IANA timezone
LIMIT_RESET_TIMEZONE=America/New_York
