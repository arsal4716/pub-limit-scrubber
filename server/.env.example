# Server - serves both the API and the built React app (client/dist) on this
# single port. Run `npm run build` (from client/ or via the root script)
# before starting in production so client/dist exists.
PORT=6003
NODE_ENV=development

# MongoDB - leave empty in development to auto-start an in-memory MongoDB instance
MONGO_URI=

# Admin login (single admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now
ADMIN_JWT_SECRET=change-this-to-a-long-random-string
ADMIN_JWT_EXPIRES_IN=12h

# Buyer LM (ACA) - callgrid. Blocked when the response code is 4007 or 4005.
LM_BUYER_API_URL=https://bid.callgrid.com/api/bid/cmn6507vj00vz06juii3memo2
LM_BUYER_API_TIMEOUT_MS=10000

# Buyer HC (ACA) - NextGen Insurance Solutions. Duplicate/suppression is
# read from the response's `phs_suppressed` field. Requires a per-lead
# state code, read from a State column in the uploaded CSV, and an API key
# sent as the `x-vendor-api-key` header - without it every call fails with
# 401 Unauthorized. NEVER commit the real key value here; set it only in
# your actual (gitignored) server/.env file.
HC_BUYER_API_URL=https://api.nextgeninsurancesolutionsinc.com/vendor-availability
HC_BUYER_API_TIMEOUT_MS=5000
HC_VENDOR_API_KEY=

# Publisher daily limits are NOT env vars - each publisher's limit is set
# individually from the admin dashboard and split 50/50 between LM and HC
# automatically when scrubbing.

# Batch size used when the admin "rate limit mode" toggle is ON (the
# default). The target rate itself (default 1000/min per buyer) is NOT an
# env var - it's set from the admin dashboard's "Scrub speed" card and
# stored in the DB, so it can be changed to 2000, 3000, 5000/min, etc.
# without a restart. The delay between batches is computed from that
# target rate; this concurrency value just caps how many requests go out
# per batch regardless of the target.
BUYER_API_CONCURRENCY=20

# Used when rate limit mode is OFF: a larger batch size with no delay
# between batches - phones are scrubbed as fast as the buyer APIs and
# network allow. A 429 (Too Many Requests) from either buyer still pauses
# that buyer for a randomized 3-4s before its next batch, in either mode.
FAST_MODE_CONCURRENCY=200

# Default global daily capacity ceiling (applied on first boot only, then
# only editable from the admin dashboard). The sum of every active
# publisher's own daily limit must never exceed this.
DEFAULT_TOTAL_DAILY_LIMIT=1000000

# Publisher usage resets at midnight in this IANA timezone
LIMIT_RESET_TIMEZONE=America/New_York
